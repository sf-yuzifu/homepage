{
  "name": "homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "yarn typecheck && vite build",
    "build:analyze": "yarn typecheck && vite build --mode analyze",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "transition:mov": "ffmpeg -y -c:v libvpx-vp9 -i public/transfrom.webm -an -vf format=rgba,premultiply=inplace=1 -c:v hevc_videotoolbox -require_sw 1 -alpha_quality 0.75 -tag:v hvc1 -q:v 30 public/transfrom.mov"
  },
  "resolutions": {
    "rollup": "^4.34.9",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-replace": "^6.0.1",
    "minimatch": "^10.0.1",
    "glob": "^11.0.1",
    "koffi": "2.10.0",
    "@esotericsoftware/spine-core": "4.2.120",
    "@esotericsoftware/spine-pixi-v8": "4.2.120"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@esotericsoftware/spine-core": "4.2.120",
    "@esotericsoftware/spine-pixi-v8": "4.2.120",
    "ba-click-fx": "^1.3.2",
    "howler": "^2.2.4",
    "pixi.js": "^8.20.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "esbuild": "^0.25.12",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.11",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-font": "^5.1.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.11",
    "zod": "^4.5.4"
  }
